#cloud-config
# k3s server. Runs once, on first boot.
write_files:
  # Hetzner can attach the private network a few seconds after boot, after networking is configured;
  # this makes any en* interface (the public one is eth0) take its address by DHCP whenever it appears.
  - path: /etc/netplan/60-private.yaml
    permissions: "0600"
    content: |
      network:
        version: 2
        ethernets:
          private:
            match: { name: "en*" }
            dhcp4: true
  # k3s applies anything in this directory; this reconfigures its bundled Traefik.
  - path: /var/lib/rancher/k3s/server/manifests/traefik-config.yaml
    content: |
      apiVersion: helm.cattle.io/v1
      kind: HelmChartConfig
      metadata:
        name: traefik
        namespace: kube-system
      spec:
        valuesContent: |-
          # The Hetzner load balancer forwards 80/443 to these ports on every node.
          service:
            type: NodePort
          ports:
            web:
              nodePort: 30080
            websecure:
              nodePort: 30443
          # Player join tokens travel in the /ws query string, so access logs stay off.
          logs:
            access:
              enabled: false

runcmd:
  # Wait for the private address (see 60-private.yaml); k3s binds to it.
  - until ip -4 addr | grep -q "inet ${node_ip}/"; do netplan apply; sleep 5; done
  # flannel would otherwise use the public interface, where the firewall drops its VXLAN traffic.
  - ip -o -4 addr show | awk -v ip='${node_ip}' 'index($4, ip "/") == 1 {print $2}' > /run/private-iface
  - >-
    curl -sfL https://get.k3s.io |
    INSTALL_K3S_VERSION='${k3s_version}' K3S_TOKEN='${k3s_token}'
    sh -s - server
    --disable servicelb
    --node-ip ${node_ip}
    --flannel-iface "$(cat /run/private-iface)"
    --advertise-address ${node_ip}
    --tls-san ${public_ip}
    --write-kubeconfig-mode 0600
